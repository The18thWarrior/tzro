[
  {
    "id": "cfb_case_01_hotel_taxi",
    "dataset": "complexfuncbench",
    "system_prompt": "You are a cross-domain assistant for booking hotels and taxis in London.",
    "tools": [
      {
        "name": "search_hotel",
        "description": "Find hotels in a city based on star ratings.",
        "parameters": {
          "type": "object",
          "properties": {
            "city": { "type": "string", "description": "The city to search." },
            "stars": {
              "type": "integer",
              "description": "The hotel star rating (1-5)."
            }
          },
          "required": ["city", "stars"]
        }
      },
      {
        "name": "book_hotel",
        "description": "Confirm booking of a hotel by ID.",
        "parameters": {
          "type": "object",
          "properties": {
            "hotel_id": {
              "type": "string",
              "description": "The hotel unique code."
            }
          },
          "required": ["hotel_id"]
        }
      },
      {
        "name": "book_taxi",
        "description": "Book a taxi cab ride to a destination at a scheduled time.",
        "parameters": {
          "type": "object",
          "properties": {
            "destination": {
              "type": "string",
              "description": "Where to drive the passenger."
            },
            "time": {
              "type": "string",
              "description": "The time of pickup (e.g. 6 PM)."
            }
          },
          "required": ["destination", "time"]
        }
      }
    ],
    "turns": [
      {
        "user_message": "Find a 5-star hotel in London.",
        "expected_tool_call": "search_hotel",
        "expected_args": { "city": "London", "stars": 5 },
        "mock_response": "{\"status\":\"success\",\"hotels\":[{\"hotel_id\":\"LND-SAVOY\",\"name\":\"The Savoy\",\"address\":\"Strand, London\"}]}"
      },
      {
        "user_message": "Great, book the hotel with ID LND-SAVOY.",
        "expected_tool_call": "book_hotel",
        "expected_args": { "hotel_id": "LND-SAVOY" },
        "mock_response": "{\"status\":\"success\",\"booking_id\":\"BK-SAVOY\"}"
      },
      {
        "user_message": "Now book a taxi to The Savoy at 6 PM.",
        "expected_tool_call": "book_taxi",
        "expected_args": { "destination": "The Savoy", "time": "6 PM" },
        "mock_response": "{\"status\":\"taxi_booked\",\"eta\":\"10 mins\"}"
      }
    ]
  }
]
